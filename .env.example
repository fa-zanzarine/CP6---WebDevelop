# Usuário do GitHub cujos repositórios viram projetos no site
VITE_GITHUB_USER=fa-zanzarine
# (Opcional) token público sem escopos, só para aumentar o limite de requisições da API
VITE_GITHUB_TOKEN=

# Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Endpoint do Formspree que envia o e-mail ao dono (https://formspree.io/f/xxxxxxxx)
VITE_FORMSPREE_ENDPOINT=
